generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Role/status fields are plain strings (constrained by the shared unions in
// lib/enums.ts) rather than native Postgres enums, carried over from when
// this schema targeted SQLite (which has no enum support) — changing them
// now would mean a data migration, not just a schema change.

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CLIENT") // CLIENT | PROFESSIONAL | ADMIN
  accountType  String   @default("INDIVIDUAL") // INDIVIDUAL | EMPLOYER
  organisation String?
  createdAt    DateTime @default(now())

  professionalProfile ProfessionalProfile?
  bookings            Booking[]            @relation("ClientBookings")
  messages            Message[]
  reviews             Review[]
  notifications       Notification[]
}

model ProfessionalProfile {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  designation        String
  bio                String
  qualifications     String
  specializations    String // comma-separated tags
  languages          String // comma-separated
  location           String
  yearsExperience    Int      @default(0)
  offersOnline       Boolean  @default(true)
  offersInPerson     Boolean  @default(false)
  verificationStatus String   @default("PENDING") // PENDING | APPROVED | REJECTED
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  photoUrl           String?
  createdAt          DateTime @default(now())

  services          ProfessionalService[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]              @relation("ProfessionalBookings")
}

model Service {
  id                  String  @id @default(cuid())
  slug                String  @unique
  name                String
  description         String
  icon                String  @default("briefcase")
  defaultPriceCents   Int
  defaultDurationMins Int     @default(45)
  active              Boolean @default(true)
  order               Int     @default(0)

  professionalServices ProfessionalService[]
  bookings             Booking[]
}

model ProfessionalService {
  id             String              @id @default(cuid())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  professionalId String
  service        Service             @relation(fields: [serviceId], references: [id])
  serviceId      String
  priceCents     Int?
  durationMins   Int?

  @@unique([professionalId, serviceId])
}

model AvailabilitySlot {
  id             String              @id @default(cuid())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  professionalId String
  startsAt       DateTime
  endsAt         DateTime
  isBooked       Boolean             @default(false)

  booking Booking?
}

model Booking {
  id               String              @id @default(cuid())
  client           User                @relation("ClientBookings", fields: [clientId], references: [id])
  clientId         String
  professional     ProfessionalProfile @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  professionalId   String
  service          Service             @relation(fields: [serviceId], references: [id])
  serviceId        String
  slot             AvailabilitySlot    @relation(fields: [slotId], references: [id])
  slotId           String              @unique
  consultationType String              @default("ONLINE") // ONLINE | IN_PERSON
  status           String              @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | COMPLETED | CANCELLED
  priceCents       Int
  issueDescription String
  createdAt        DateTime            @default(now())

  payment  Payment?
  review   Review?
  messages Message[]
}

model Payment {
  id          String    @id @default(cuid())
  booking     Booking   @relation(fields: [bookingId], references: [id])
  bookingId   String    @unique
  amountCents Int
  status      String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  provider    String    @default("MANUAL")
  reference   String
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @unique
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime @default(now())
}

model Resource {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String // GUIDE | TEMPLATE | LAW | CALCULATOR | ARTICLE | WEBINAR
  summary       String
  body          String
  fileUrl       String?
  author        String   @default("Black Pearl Inc. Team")
  isPremium     Boolean  @default(false)
  downloadCount Int      @default(0)
  publishedAt   DateTime @default(now())
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  role     String
  bio      String
  photoUrl String?
  linkedIn String?
  order    Int     @default(0)
}

model SiteStat {
  id    String @id @default(cuid())
  key   String @unique
  label String
  value String
  order Int    @default(0)
}

model Notification {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String
  type    String
  payload String
  sentAt  DateTime @default(now())
}
